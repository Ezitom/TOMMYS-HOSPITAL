# ==============================================================================
# TOMMY'S HOSPITAL — Environment Variables Reference
# ==============================================================================
# Use this file as a guide for what environment variables to configure in your
# Render (Backend) and Netlify (Frontend) dashboard settings.
# DO NOT commit real secrets (.env) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (RENDER DASHBOARD) ENVIRONMENT VARIABLES
# Set these in Render Dashboard -> Your Web Service -> Environment Variables
# ------------------------------------------------------------------------------

# Server Port (Render sets this dynamically, defaults to 10000 on Render, 3000 locally)
PORT=10000

# Node Environment
NODE_ENV=production

# Frontend Origin URL for CORS (Set to your deployed Netlify domain)
# Example: https://justpathhospital.netlify.app
FRONTEND_URL=https://YOUR-SITE-NAME.netlify.app

# Supabase Database & Auth Keys (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Email Configuration (Nodemailer with Gmail SMTP)
# Requires a 16-character Google App Password (2-Step Verification enabled)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=TOMMY'S HOSPITAL

# ------------------------------------------------------------------------------
# 2. FRONTEND (NETLIFY / CLIENT-SIDE) CONFIGURATION
# Set in js/config.js and dashboards/js/config.js
# ------------------------------------------------------------------------------

# Render Backend URL (The live URL assigned to your Render web service)
# Example: https://just-path-hospital-backend.onrender.com
API_BASE_URL=https://YOUR-RENDER-APP-NAME.onrender.com
